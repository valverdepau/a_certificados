DATABASE_URL=

# Usuarios de la aplicación. Si faltan, la app entra en "modo demostración".
# En Vercel estos mismos nombres se cargan en Settings > Environment Variables.
ADMIN_CORREO=
ADMIN_CLAVE=
USUARIO_CORREO=
USUARIO_CLAVE=
